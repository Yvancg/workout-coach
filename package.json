{
  "name": "workout-coach",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/e2e-browser.mjs",
    "check:web-budget": "node scripts/check-web-budget.mjs",
    "check:android": "node scripts/check-android.mjs",
    "cf:dev": "wrangler dev worker/src/index.js",
    "cf:deploy": "wrangler deploy worker/src/index.js",
    "d1:migrate:local": "wrangler d1 migrations apply workout_coach --local",
    "d1:migrate:remote": "wrangler d1 migrations apply workout_coach --remote",
    "android:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run android:sync && bash -lc 'cd android && ./gradlew assembleDebug --no-daemon'",
    "android:open": "npm run android:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@supabase/supabase-js": "2.117.3",
    "jose": "^6.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "wrangler": "^4.71.0"
  }
}
